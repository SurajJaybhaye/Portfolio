# AI assistant. Copy this file to .env.local and fill in what you need.
# With nothing set, the assistant runs in DEMO mode: a built-in FAQ answers from
# lib/content.ts, with no API calls and no cost.
#
# Never commit .env.local. On Vercel, add the same variables under
# Project Settings -> Environment Variables.

# --- Site address (link previews) ---------------------------------------------
# Used to build the full URL of the link-preview image on LinkedIn and WhatsApp.
# Set it to your real domain once you have one. On Vercel, if this is empty, the
# project's production domain is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Option A: Claude -------------------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5        # optional. Examples: claude-sonnet-5-5, claude-haiku-4-5

# --- Option B: any OpenAI-compatible API (Groq, Gemini, OpenRouter, Mistral) --
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=
# AI_FALLBACK_MODEL=gemini-3.5-flash-lite   # optional backup model, tried when the main one is overloaded (503) or out of quota (429)
# AI_REASONING_EFFORT=none       # optional, for "thinking" models. "none" is fastest and fine for this Q&A.
#                                # Support differs per model: gemini-3.8-flash accepts none/low/medium/high but rejects "minimal".
# Common base URLs (check the provider's docs, they can change):
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/   (models e.g. gemini-3.8-flash, gemini-3.5-flash-lite)
#   OpenRouter  https://openrouter.ai/api/v1
#   Mistral     https://api.mistral.ai/v1

# --- Limits (optional) -------------------------------------------------------
# Set AI_DAILY_LIMIT to roughly 70% of your provider's free daily request limit
# (Google AI Studio shows yours). When it is reached, the assistant switches to the
# built-in FAQ instead of failing. Starter-question chips never use quota.
# AI_DAILY_LIMIT=300              # live-AI requests per day across all visitors
# AI_VISITOR_DAILY_LIMIT=20       # questions per visitor (by IP) per day
# AI_BURST_LIMIT=8                # questions per visitor per 10 minutes
# AI_MAX_TOKENS=1200              # reply-length ceiling (not a target). Keep headroom if the model "thinks".
